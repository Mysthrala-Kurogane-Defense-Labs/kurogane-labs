    "func": "const events = [\n  {\n    \"type\": \"asset\",\n    \"event_id\": \"basic-plant-monitoring-00001\",\n    \"occurred_at\": \"2026-01-01T00:00:00Z\",\n    \"site_id\": \"site-synthetic-alpha\",\n    \"asset_id\": \"pump-1\",\n    \"name\": \"pump-1\",\n    \"asset_type\": \"pump\"\n  },\n  {\n    \"type\": \"asset\",\n    \"event_id\": \"basic-plant-monitoring-00002\",\n    \"occurred_at\": \"2026-01-01T00:00:00Z\",\n    \"site_id\": \"site-synthetic-alpha\",\n    \"asset_id\": \"compressor-1\",\n    \"name\": \"compressor-1\",\n    \"asset_type\": \"compressor\"\n  },\n  {\n    \"type\": \"telemetry\",\n    \"event_id\": \"basic-plant-monitoring-00003\",\n    \"occurred_at\": \"2026-01-01T00:01:00Z\",\n    \"site_id\": \"site-synthetic-alpha\",\n    \"asset_id\": \"pump-1\",\n    \"metric\": \"pressure_bar\",\n    \"value\": 2.5,\n    \"unit\": \"bar\"\n  },\n  {\n    \"type\": \"telemetry\",\n    \"event_id\": \"basic-plant-monitoring-00004\",\n    \"occurred_at\": \"2026-01-01T00:01:00Z\",\n    \"site_id\": \"site-synthetic-alpha\",\n    \"asset_id\": \"compressor-1\",\n    \"metric\": \"pressure_bar\",\n    \"value\": 2.5,\n    \"unit\": \"bar\"\n  },\n  {\n    \"type\": \"alarm\",\n    \"event_id\": \"basic-plant-monitoring-00005\",\n    \"occurred_at\": \"2026-01-01T00:01:01Z\",\n    \"site_id\": \"site-synthetic-alpha\",\n    \"asset_id\": \"pump-1\",\n    \"severity\": \"warning\",\n    \"message\": \"Synthetic pressure review\"\n  }\n];\nreturn [events.map(payload => ({payload}))];",
